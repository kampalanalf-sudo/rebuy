# Rebuy — environment template.  Copy to .env, fill in, never commit .env.
# ---------------------------------------------------------------------------

# production | staging | development
# In production the app refuses to boot without a strong REBUY_SECRET_KEY,
# sets Secure cookies, closes self-serve signup and refuses to seed demo data.
REBUY_ENV=development

# REQUIRED in production. 32+ characters, generated per deployment:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this signs every user out (sessions are stored hashed, not derived,
# so existing sessions survive a rotation — remove them with /api/auth/logout-all).
REBUY_SECRET_KEY=

# Public https origin, e.g. https://app.rebuy.ug — used to build the Google
# redirect URI and invitation links. Leave blank locally to infer from Host.
REBUY_PUBLIC_URL=

# ------------------------------------------------------------------ database
# Postgres / Supabase. Omit to use SQLite at REBUY_DB.
REBUY_DATABASE_URL=
REBUY_DB=./data/rebuy.db

# ------------------------------------------------------------------- sign-in
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: ${REBUY_PUBLIC_URL}/api/auth/google/callback
REBUY_GOOGLE_CLIENT_ID=
REBUY_GOOGLE_CLIENT_SECRET=

# Comma-separated emails promoted to platform admin on first sign-in.
# Set this BEFORE the first production login or nobody can reach /admin.
# The live deployment uses: kampalanalf@gmail.com
REBUY_ADMIN_EMAILS=

# Optional invite wall: when set, only these emails may create an account.
REBUY_ALLOWED_EMAILS=

# Self-serve shop signup. Defaults to on outside production, off in production.
REBUY_ALLOW_SIGNUP=

# --------------------------------------------------------------------- demo
# Demo fleet seeding. Defaults to on outside production, always refused in
# production. Demo users are @example.com addresses with random passwords.
REBUY_SEED_DEMO=
REBUY_SEED_SHOPS=120

# -------------------------------------------------------------- messaging
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# ----------------------------------------------------------------- runtime
REBUY_WORKER=1
CRON_SECRET=
REBUY_ALLOWED_HOSTS=
REBUY_CSP=
